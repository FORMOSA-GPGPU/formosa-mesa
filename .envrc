# Local paths belong in .envrc.local; see .envrc.local.example.
source_env_if_exists ./.envrc.local
if [[ -z ${FORMOSA_SOURCE_DIR:-} || ! -f $FORMOSA_SOURCE_DIR/flake.nix ]]; then
  log_error "set FORMOSA_SOURCE_DIR to a Formosa checkout in .envrc.local"
  return 1
fi
export FORMOSA_SOURCE_DIR="$(realpath "$FORMOSA_SOURCE_DIR")"
watch_file "$FORMOSA_SOURCE_DIR/flake.nix" "$FORMOSA_SOURCE_DIR/flake.lock"
use flake "path:$FORMOSA_SOURCE_DIR#vulkan-compute" || return 1
source_env "$FORMOSA_SOURCE_DIR/scripts/local-runtime.sh" || return 1
formosa_load_toolchain_overrides || return 1

if [[ -n ${FORMOSA_INSTALL_PREFIX:-} ]]; then
  formosa_override_warning SDK "$FORMOSA_INSTALL_PREFIX"
fi
export FORMOSA_INSTALL_PREFIX="${FORMOSA_INSTALL_PREFIX:-$FORMOSA_DEFAULT_SDK}"
if [[ ! -f $FORMOSA_INSTALL_PREFIX/lib/libformosa-hal.lv.a ]]; then
  log_error "install the Formosa SDK first: $FORMOSA_INSTALL_PREFIX"
  return 1
fi
export FORMOSA_INSTALL_PREFIX="$(realpath "$FORMOSA_INSTALL_PREFIX")"
export MESA_INSTALL_PREFIX="$(realpath -m "${MESA_INSTALL_PREFIX:-$PWD/outputs/out}")"
# Use PoCL's persistent-launcher scheme: installed shaders keep their build-time
# LLVM/runtime selection even when the caller has different overrides.
formosa_clang_wrapper="$(command -v formosa-clang)" || return 1
formosa_clang_script="$(printf '#!%s\nexport FORMOSA_LLVM_PREFIX=%q\nexport FORMOSA_RUNTIME_PREFIX=%q\nexec %q "$@"\n' \
  "$(command -v bash)" "${FORMOSA_LLVM_PREFIX:-}" "${FORMOSA_RUNTIME_PREFIX:-}" \
  "$formosa_clang_wrapper")" || return 1
formosa_clang_hash="$(printf '%s\n' "$formosa_clang_script" | sha256sum)" || return 1
export FORMOSA_CLANG_PATH="$PWD/outputs/toolchains/formosa-clang-${formosa_clang_hash%% *}"
if [[ ! -x $FORMOSA_CLANG_PATH ]]; then
  mkdir -p "$PWD/outputs/toolchains" || return 1
  formosa_clang_tmp="$(mktemp "$PWD/outputs/toolchains/.formosa-clang.XXXXXX")" || return 1
  if ! { printf '%s\n' "$formosa_clang_script" > "$formosa_clang_tmp" &&
         chmod +x "$formosa_clang_tmp" &&
         mv -f "$formosa_clang_tmp" "$FORMOSA_CLANG_PATH"; }; then
    rm -f "$formosa_clang_tmp"
    return 1
  fi
fi

if [[ -n ${FORMOSA_POCL_PREFIX:-} ]]; then
  for formosa_pocl_file in bin/poclcc share/pocl/include/_kernel.h share/pocl/kernel-riscv64-formosa.bc; do
    if [[ ! -f $FORMOSA_POCL_PREFIX/$formosa_pocl_file ]]; then
      log_error "local PoCL is missing $formosa_pocl_file: $FORMOSA_POCL_PREFIX"
      return 1
    fi
  done
  PATH_add "$FORMOSA_POCL_PREFIX/bin"
  formosa_override_warning POCL "$FORMOSA_POCL_PREFIX"
fi

export MESA_NATIVE_FILE="$PWD/.direnv/formosa.ini"
mkdir -p .direnv
python3 - <<'PY' || return 1
import os
import shutil
from pathlib import Path


def quote(value):
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


lines = ["[binaries]"]
for tool in ("llvm-config", "poclcc", "formosa-clang"):
    path = os.environ["FORMOSA_CLANG_PATH"] if tool == "formosa-clang" else shutil.which(tool)
    if tool == "poclcc" and os.environ.get("FORMOSA_POCL_PREFIX"):
        path = str(Path(os.environ["FORMOSA_POCL_PREFIX"]) / "bin/poclcc")
    if not path or not os.access(path, os.X_OK):
        raise SystemExit(f"Missing Formosa tool: {tool}")
    lines.append(f"{tool} = {quote(path)}")
lines += [
    "[built-in options]",
    "prefix = " + quote(os.environ["MESA_INSTALL_PREFIX"]),
    "libdir = 'lib'", "buildtype = 'debugoptimized'", "cpp_rtti = false",
    "wrap_mode = 'nofallback'",
    "[project options]",
    "formosa-sdk = " + quote(os.environ["FORMOSA_INSTALL_PREFIX"]),
    "platforms = []", "gallium-drivers = []", "vulkan-drivers = ['formosa']",
    "glx = 'disabled'", "egl = 'disabled'", "gles1 = 'disabled'", "gles2 = 'disabled'",
    "opengl = false", "gbm = 'disabled'", "llvm = 'enabled'", "shared-llvm = 'enabled'",
    "tools = ['fsa-compute']", "build-tests = false", "video-codecs = []",
]
native_file = Path(os.environ["MESA_NATIVE_FILE"])
content = "\n".join(lines) + "\n"
if not native_file.exists() or native_file.read_text() != content:
    native_file.write_text(content)
PY
log_status "Formosa SDK: $FORMOSA_INSTALL_PREFIX"
log_status "Mesa install: $MESA_INSTALL_PREFIX"
log_status 'Configure: meson setup build --native-file "$MESA_NATIVE_FILE"'
